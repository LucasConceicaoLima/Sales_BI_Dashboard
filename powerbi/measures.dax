// Medidas principais de vendas

Receita =
SUM ( FactSales[net_revenue] )

Receita Bruta =
SUM ( FactSales[gross_revenue] )

Lucro Bruto =
SUM ( FactSales[gross_profit] )

Custo Total =
SUM ( FactSales[total_cost] )

Unidades Vendidas =
SUM ( FactSales[net_quantity] )

Transações =
DISTINCTCOUNT ( FactSales[sale_id] )

Clientes Ativos =
DISTINCTCOUNT ( FactSales[customer_id] )

Ticket Médio =
DIVIDE ( [Receita], [Transações] )

Margem Bruta % =
DIVIDE ( [Lucro Bruto], [Receita] )

Desconto Médio % =
AVERAGE ( FactSales[discount_pct] )

Receita YTD =
TOTALYTD ( [Receita], DimDate[date] )

Receita Ano Anterior =
CALCULATE (
    [Receita],
    SAMEPERIODLASTYEAR ( DimDate[date] )
)

Crescimento Receita YoY % =
DIVIDE ( [Receita] - [Receita Ano Anterior], [Receita Ano Anterior] )

Receita Mês Anterior =
CALCULATE (
    [Receita],
    DATEADD ( DimDate[date], -1, MONTH )
)

Crescimento Receita MoM % =
DIVIDE (
    [Receita] - [Receita Mês Anterior],
    [Receita Mês Anterior]
)

Receita por Cliente =
DIVIDE ( [Receita], [Clientes Ativos] )

Taxa de Devolução % =
DIVIDE (
    CALCULATE (
        COUNTROWS ( FactSales ),
        FactSales[order_status] = "Devolvido"
    ),
    COUNTROWS ( FactSales )
)